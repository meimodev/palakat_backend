generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model Church {
  id                  Int                  @id @default(autoincrement())
  name                String
  latitude            String
  longitude           String
  address             String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  columns             Column[]
  memberships         Membership[]
  membershipPositions MembershipPosition[]
}

model Column {
  id                  Int                  @id @default(autoincrement())
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  churchId            Int
  church              Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberships         Membership[]
  membershipPositions MembershipPosition[]
}

model Membership {
  id                   Int                  @id @default(autoincrement())
  baptize              Boolean              @default(false)
  sidi                 Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  accountId            Int                  @unique
  columnId             Int
  churchId             Int
  supervisorActivities Activity[]           @relation("SupervisorActivities")
  approvers            Approver[]
  account              Account              @relation(fields: [accountId], references: [id])
  church               Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  column               Column               @relation(fields: [columnId], references: [id], onDelete: Cascade)
  membershipPositions  MembershipPosition[]
}

model MembershipPosition {
  id           Int        @id @default(autoincrement())
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membershipId Int
  membership   Membership @relation(fields: [membershipId], references: [id])
  churchId     Int
  church       Church     @relation(fields: [churchId], references: [id])
  columnId     Int
  column       Column     @relation(fields: [columnId], references: [id])
}

model Account {
  id           Int         @id @default(autoincrement())
  name         String
  phone        String      @unique
  gender       Gender
  married      Boolean
  dob          DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  membershipId Int?
  membership   Membership?
}

model Activity {
  id           Int          @id @default(autoincrement())
  supervisorId Int
  bipra        Bipra
  title        String
  description  String?
  locationId   Int?         @unique
  date         DateTime?
  note         String?
  fileUrl      String?
  activityType ActivityType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  supervisor   Membership   @relation("SupervisorActivities", fields: [supervisorId], references: [id], onDelete: Cascade)
  approvers    Approver[]
  location     Location?    @relation(fields: [locationId], references: [id])

  @@index([date])
  @@index([supervisorId])
}

// Helpful indexes for query performance

model Location {
  id        Int       @id @default(autoincrement())
  name      String
  latitude  Decimal   @db.Decimal(9, 6)
  longitude Decimal   @db.Decimal(9, 6)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  activity  Activity?
}

model Approver {
  id           Int            @id @default(autoincrement())
  membershipId Int
  membership   Membership     @relation(fields: [membershipId], references: [id])
  activityId   Int
  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status       ApprovalStatus @default(UNCONFIRMED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([activityId, membershipId])
  @@index([activityId])
  @@index([membershipId])
}

enum ApprovalStatus {
  UNCONFIRMED
  APPROVED
  REJECTED
}

model Song {
  id        Int        @id @default(autoincrement())
  title     String
  index     Int        @unique
  book      Book
  link      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parts     SongPart[]
}

model SongPart {
  id      Int    @id @default(autoincrement())
  index   Int
  name    String
  content String
  songId  Int
  song    Song   @relation(fields: [songId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum Bipra {
  PKB
  WKI
  PMD
  RMJ
  ASM
}

enum ActivityType {
  SERVICE
  EVENT
  ANNOUNCEMENT
}

enum Book {
  NKB
  NNBT
  KJ
  DSL
}
